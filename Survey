<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Support Script Hub - Service Rating</title>
    <style>
        :root {
            --bg-color: #03182b;
            --card-bg: #06233f;
            --accent-cyan: #00bcd4;
            --text-color: #ffffff;
            --input-bg: #02111e;
            --border-color: #0d47a1;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .nav-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

        .tab-btn {
            background-color: var(--card-bg);
            color: var(--text-color);
            border: 1px solid var(--accent-cyan);
            padding: 10px 20px;
            cursor: pointer;
            font-weight: bold;
            border-radius: 4px;
        }

        .tab-btn.active {
            background-color: var(--accent-cyan);
            color: #000;
        }

        .container {
            background-color: var(--card-bg);
            border: 2px solid var(--border-color);
            border-radius: 6px;
            padding: 30px;
            width: 100%;
            max-width: 700px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }

        h2 {
            color: var(--accent-cyan);
            text-align: center;
            margin-top: 0;
            letter-spacing: 1px;
        }

        .subtitle {
            text-align: center;
            font-size: 0.9em;
            margin-bottom: 25px;
            color: #b0bec5;
        }

        .form-group {
            display: grid;
            grid-template-columns: 150px 1fr;
            align-items: center;
            margin-bottom: 18px;
        }

        label {
            font-weight: bold;
        }

        input[type="text"], select, textarea {
            background-color: var(--input-bg);
            color: #fff;
            border: 1px solid var(--accent-cyan);
            padding: 8px 12px;
            border-radius: 3px;
            font-size: 14px;
            width: 100%;
            box-sizing: border-box;
        }

        textarea {
            height: 100px;
            resize: vertical;
        }

        .btn-submit {
            background-color: transparent;
            color: var(--text-color);
            border: 2px solid var(--accent-cyan);
            padding: 12px;
            width: 100%;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.2s;
        }

        .btn-submit:hover {
            background-color: var(--accent-cyan);
            color: #000;
        }

        /* Table Styling */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            background-color: #e0e0e0;
            color: #000;
        }

        th, td {
            border: 1px solid #9e9e9e;
            padding: 8px 12px;
            text-align: left;
            font-size: 13px;
        }

        th {
            background-color: #000;
            color: #fff;
        }

        tr:nth-child(even) {
            background-color: #eeeeee;
        }

        .summary-card {
            background-color: var(--input-bg);
            border: 1px solid var(--accent-cyan);
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 4px;
        }

        .summary-card h3 {
            margin-top: 0;
            color: var(--accent-cyan);
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>

    <div class="nav-tabs">
        <button class="tab-btn active" onclick="switchTab('agent')">Agent Submission Form</button>
        <button class="tab-btn" onclick="switchTab('supervisor')">Supervisor View</button>
    </div>

    <!-- Agent View -->
    <div id="agent-view" class="container">
        <h2>SUPPORT SERVICE RATING</h2>
        <div class="subtitle">Submit feedback for technical support assistance</div>

        <form id="ratingForm">
            <div class="form-group">
                <label for="caseNumber">Case Number:</label>
                <input type="text" id="caseNumber" required>
            </div>

            <div class="form-group">
                <label for="supportPerson">Support Person:</label>
                <select id="supportPerson" required>
                    <option value="">-- Select Support Person --</option>
                    <option value="Zachary Jeremy Payabyab">Zachary Jeremy Payabyab</option>
                    <option value="Christian Mark Patdu">Christian Mark Patdu</option>
                    <option value="Aj Dela Cruz">Aj Dela Cruz</option>
                </select>
            </div>

            <div class="form-group">
                <label for="rating">Rating (1 - 5):</label>
                <select id="rating" required>
                    <option value="">-- Select Rating --</option>
                    <option value="5">5 - Excellent</option>
                    <option value="4">4 - Good</option>
                    <option value="3">3 - Average</option>
                    <option value="2">2 - Below Average</option>
                    <option value="1">1 - Poor</option>
                </select>
            </div>

            <div class="form-group">
                <label for="notes">Notes / Feedback:</label>
                <textarea id="notes"></textarea>
            </div>

            <button type="submit" class="btn-submit">SUBMIT RATING</button>
        </form>
    </div>

    <!-- Supervisor View -->
    <div id="supervisor-view" class="container hidden" style="max-width: 900px;">
        <h2>SUPERVISOR DASHBOARD</h2>
        <div class="subtitle">Submitted Ratings & Performance Analytics</div>

        <!-- Average per Support Summary -->
        <div class="summary-card">
            <h3>Average Rating Per Support Person</h3>
            <table style="background-color: #fff;" id="summaryTable">
                <thead>
                    <tr style="background-color: var(--card-bg); color: #fff;">
                        <th style="background-color: #06233f;">Support Person</th>
                        <th style="background-color: #06233f;">Total Ratings Received</th>
                        <th style="background-color: #06233f;">Average Rating</th>
                    </tr>
                </thead>
                <tbody id="summaryBody"></tbody>
            </table>
        </div>

        <!-- Raw Log Table -->
        <h3>All Responses</h3>
        <table id="resultsTable">
            <thead>
                <tr>
                    <th>Timestamp</th>
                    <th>AgentUser</th>
                    <th>CaseNumber</th>
                    <th>SupportName</th>
                    <th>Rating</th>
                    <th>Comments</th>
                </tr>
            </thead>
            <tbody id="resultsBody"></tbody>
        </table>
    </div>

    <script>
        // Load existing records or default sample array
        let submissions = JSON.parse(localStorage.getItem('supportRatings')) || [
            { timestamp: '8/11/2026 13:15', agentUser: 'hmaneja', caseNumber: '1234564', supportName: 'Zachary Jeremy Payabyab', rating: 5, comments: 'Nice job!' },
            { timestamp: '8/11/2026 13:09', agentUser: 'hmaneja', caseNumber: '1234324', supportName: 'Christian Mark Patdu', rating: 5, comments: 'Excellet job!' },
            { timestamp: '8/11/2026 13:08', agentUser: 'hmaneja', caseNumber: '123456442', supportName: 'Christian Mark Patdu', rating: 4, comments: 'Good job!' },
            { timestamp: '8/11/2026 13:07', agentUser: 'hmaneja', caseNumber: '12345678', supportName: 'Aj Dela Cruz', rating: 4, comments: '12443534' }
        ];

        function switchTab(view) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            if (view === 'agent') {
                document.getElementById('agent-view').classList.remove('hidden');
                document.getElementById('supervisor-view').classList.add('hidden');
                event.target.classList.add('active');
            } else {
                document.getElementById('agent-view').classList.add('hidden');
                document.getElementById('supervisor-view').classList.remove('hidden');
                event.target.classList.add('active');
                renderSupervisorDashboard();
            }
        }

        // Form Submission Logic
        document.getElementById('ratingForm').addEventListener('submit', function(e) {
            e.preventDefault();

            const now = new Date();
            const formattedDate = `${now.getMonth()+1}/${now.getDate()}/${now.getFullYear()} ${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

            const newEntry = {
                timestamp: formattedDate,
                agentUser: 'hmaneja', // Dynamic or hardcoded agent identity
                caseNumber: document.getElementById('caseNumber').value,
                supportName: document.getElementById('supportPerson').value,
                rating: parseInt(document.getElementById('rating').value),
                comments: document.getElementById('notes').value
            };

            submissions.unshift(newEntry);
            localStorage.setItem('supportRatings', JSON.stringify(submissions));

            alert('Rating submitted successfully!');
            this.reset();
        });

        // Dashboard Rendering Logic
        function renderSupervisorDashboard() {
            const resultsBody = document.getElementById('resultsBody');
            const summaryBody = document.getElementById('summaryBody');

            // Render Raw Submissions
            resultsBody.innerHTML = '';
            submissions.forEach(entry => {
                const row = `<tr>
                    <td>${entry.timestamp}</td>
                    <td>${entry.agentUser}</td>
                    <td>${entry.caseNumber}</td>
                    <td>${entry.supportName}</td>
                    <td>${entry.rating}</td>
                    <td>${entry.comments}</td>
                </tr>`;
                resultsBody.innerHTML += row;
            });

            // Calculate Aggregates per Support Person
            const totals = {};
            submissions.forEach(entry => {
                if (!totals[entry.supportName]) {
                    totals[entry.supportName] = { count: 0, sum: 0 };
                }
                totals[entry.supportName].count += 1;
                totals[entry.supportName].sum += entry.rating;
            });

            // Render Aggregates
            summaryBody.innerHTML = '';
            for (const name in totals) {
                const avg = (totals[name].sum / totals[name].count).toFixed(2);
                const row = `<tr>
                    <td><strong>${name}</strong></td>
                    <td>${totals[name].count}</td>
                    <td><strong>${avg} / 5.00</strong></td>
                </tr>`;
                summaryBody.innerHTML += row;
            }
        }
    </script>
</body>
</html>
